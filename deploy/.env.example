# Mira-Guardian-Server — Betriebskonfiguration
#
# Vorlage nach .env kopieren und ausfüllen; die .env enthält ein Zugriffstoken
# und sollte deshalb nur dem Betreiber lesbar sein (chmod 600).
#
# Pflichtfelder: ADO_BASE_URL, ADO_COLLECTION, ADO_PROJECT, ADO_REPO, ADO_PAT.
# Fehlt eines davon, beendet sich der Container beim Start mit einem
# Validierungsfehler (sichtbar über `docker compose logs`).
#
# DB_PATH und HTTP_PORT stehen absichtlich nicht hier, sondern in
# docker-compose.yml — sie beschreiben das Deployment, nicht das Projekt.

# --- Azure-DevOps-Zugang ---
ADO_BASE_URL=
ADO_COLLECTION=
ADO_PROJECT=
ADO_REPO=
ADO_BRANCH=main

# Personal Access Token mit Leserecht auf Code des obigen Repos.
ADO_PAT=

# --- Beobachtete Memory-Bank-Pfade (greifen auf jeder Repo-Ebene) ---
SCAN_PATHS=docs/decisions,docs/learnings,docs/processes,.claude/rules

# --- Abfrageintervall und Rückschau einer frischen Instanz ---
POLL_INTERVAL_SECONDS=60
BACKFILL_DAYS=7

# --- Deployment ---
# Release-Version, Pflichtangabe: https://github.com/joCur/mira-guardian/releases
# Wählt nur den Image-Tag; `latest` ist erlaubt. Welche Version wirklich läuft,
# sagt der Server in seiner Startzeile und unter /health — die steckt im Image
# und ist hier nicht einstellbar.
GUARDIAN_VERSION=0.1.9

# Besitzer der Datenbankdateien — mit `id -u` und `id -g` ermitteln.
GUARDIAN_UID=1000
GUARDIAN_GID=1000

# Port auf dem Host; im Container bleibt es 4000.
GUARDIAN_PORT=4000
