[Unit]
Description=Alle fünf Minuten nach einer neuen Guardian-Server-Version sehen
Documentation=https://github.com/joCur/mira-guardian/blob/main/deploy/README.md

[Timer]
# Alle fünf Minuten. Ein Release entsteht bei jedem Push auf main, und der Server
# soll ihm nicht sichtbar hinterherlaufen. Ein Lauf ohne neues Image kostet eine
# Digest-Abfrage an der Registry und lässt den Container unberührt — teuer wird
# erst der Lauf, der wirklich etwas findet.
OnCalendar=*:0/5

# Bewusst ohne RandomizedDelaySec: bei fünf Minuten Abstand würde ein Versatz, der
# überhaupt etwas streut, einen guten Teil des Takts verschlucken.
#
# Bewusst ohne Persistent: das lohnt sich für Läufe, die nach einer Ausfallzeit
# fehlen würden — hier ist der nächste ohnehin höchstens fünf Minuten entfernt.

[Install]
WantedBy=timers.target
