# Azure-DevOps-Zugang
ADO_BASE_URL=https://ado.example.com
ADO_COLLECTION=DefaultCollection
ADO_PROJECT=MeinProjekt
ADO_REPO=mein-repo
ADO_BRANCH=main
ADO_PAT=

# Beobachtete Memory-Bank-Pfade (greifen auf jeder Repo-Ebene)
SCAN_PATHS=docs/decisions,docs/learnings,docs/processes,.claude/rules

# Abfrageintervall und Rückschau einer frischen Instanz
POLL_INTERVAL_SECONDS=60
BACKFILL_DAYS=7

DB_PATH=guardian.sqlite
HTTP_PORT=4000
